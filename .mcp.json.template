{
  "_comment": "Copy to <your-project>/.mcp.json. PIN serena ref (replace @main with a commit SHA) before sandbox use.",
  "_security_note": "git+https without a pinned ref allows upstream takeover to execute arbitrary code via uvx. Replace 'main' with a known-good commit hash.",
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "_serena_pin_note": "Pinned to oraios/serena @ 9b292a6c8b03c8306f117efeabb0ea7afdb0b3c0. Refresh the pin (and re-run install.sh with SERENA_REF=<new sha>) when upgrading. This project-scope entry takes precedence over the user-scope registration written by scripts/install.sh.",
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@9b292a6c8b03c8306f117efeabb0ea7afdb0b3c0",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "."
      ]
    }
  },
  "_mobile_instructions": "Optional iOS-development MCPs. Uncomment-and-move into 'mcpServers' to enable. Both require Xcode on host. ios-simulator-mcp uses git+https \u2014 PIN the ref (replace @main with a commit SHA) before sandbox use.",
  "_mobile_mcpServers": {
    "XcodeBuildMCP": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp"
      ]
    },
    "ios-simulator-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/joshuayoes/ios-simulator-mcp@<PIN-TO-COMMIT-SHA>",
        "ios-simulator-mcp"
      ]
    }
  }
}
