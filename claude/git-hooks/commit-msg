#!/usr/bin/env bash
# Global git commit-msg hook (core.hooksPath = ~/.claude/git-hooks).
# Enforces conventional commits on the final message, then runs the repo's own
# commit-msg hook (.git/hooks/commit-msg or .githooks/commit-msg) if there is one.
#
# Accepts: <type>[(scope)][!]: <description>, header <= 100 chars, where type is
#          feat fix refactor docs test chore perf style build ci revert.
# Passes:  git-generated subjects (Merge ..., Revert "...", fixup!/squash!/amend!).
# Rejects: wip subjects (allowed inside .claude/worktrees/ agent worktrees),
#          AI attribution (Co-Authored-By an AI, "Generated with Claude"), emoji.
# A rejection leaves one line in the kit's event log: the rule, never the message.
set -u

chain() {
  local name=$1 self h; shift
  self=$(realpath "$0")
  for h in "$(git rev-parse --git-common-dir)/hooks/$name" "$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/$name"; do
    [ -x "$h" ] && [ "$(realpath "$h")" != "$self" ] || continue
    printf '%s' "${HOOK_STDIN:-}" | "$h" "$@" || return $?
  done
}

python3 - "$1" "$(git rev-parse --show-toplevel 2>/dev/null)" "$(dirname "$(realpath "$0")")/../hooks/kitlog.py" <<'PY' || exit 1
import re, subprocess, sys

msg = open(sys.argv[1], encoding="utf-8", errors="replace").read()
msg = msg.split("# ------------------------ >8 ------------------------")[0]
lines = [ln for ln in msg.splitlines() if not ln.startswith("#")]
body = "\n".join(lines)
subject = next((ln.strip() for ln in lines if ln.strip()), "")
in_worktree = "/.claude/worktrees/" in sys.argv[2] + "/"

def fail(rule, why):
    print(f"commit-msg: {why} [{rule}]\n  subject: {subject}", file=sys.stderr)
    try:  # one line in the kit's event log; a log that cannot be written changes nothing
        subprocess.run([sys.executable, sys.argv[3], "commit-msg", "block", rule, why], timeout=10,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    sys.exit(1)

if not subject or re.match(r'(Merge |Revert "|fixup! |squash! |amend! )', subject):
    sys.exit(0)

AI = r"(claude|anthropic|openai|chatgpt|gpt-?\d|copilot|gemini|cursor|codex)"
if re.search(rf"(?im)^\s*co-authored-by:.*{AI}", body) or \
   re.search(rf"(?i)generated (with|by)\W+.{{0,40}}{AI}", body) or \
   re.search(r"(?i)noreply@anthropic\.com", body):
    fail("commit-msg.ai-attribution", "AI attribution is not allowed in commit messages")

EMOJI = re.compile("[\U0001F000-\U0001FAFF☀-⛿✅✊✋✨❌❎"
                   "❓-❕❗➕-➗➰➿⭐⭕️]")
if EMOJI.search(body):
    fail("commit-msg.emoji", f"emoji are not allowed ({EMOJI.search(body).group()!r})")

if re.match(r"(?i)wip\b", subject) or re.fullmatch(r"(?i)\w+(\([^)]*\))?!?:\s*wip\W*", subject):
    if in_worktree:
        sys.exit(0)
    fail("commit-msg.wip", "wip commits are only allowed in .claude/worktrees/ agent worktrees")

TYPES = "feat|fix|refactor|docs|test|chore|perf|style|build|ci|revert"
if not re.match(rf"({TYPES})(\([\w./,\- ]+\))?!?: \S", subject):
    fail("commit-msg.format", f"use conventional commits: <type>[(scope)][!]: <description>, type one of {TYPES.replace('|', ' ')}")
if len(subject) > 100:
    fail("commit-msg.subject-length", f"subject is {len(subject)} chars; keep it to 100")
PY

chain commit-msg "$@" || exit $?
exit 0
