#!/usr/bin/env bash
# Global git pre-commit hook (core.hooksPath = ~/.claude/git-hooks).
# Scans staged content with gitleaks, then runs the repo's own pre-commit hook
# (.git/hooks/pre-commit or .githooks/pre-commit) if there is one.
#   - gitleaks missing: warn and allow.
#   - PIPELINEKIT_ALLOW_SECRET=1: skip the scan for one commit (humans only;
#     the Claude bash-guard hook refuses that assignment).
#   - gitleaks >= 8.19: `gitleaks git --staged`; older: `gitleaks protect --staged`.
set -u

chain() {
  local name=$1 self h; shift
  self=$(realpath "$0")
  for h in "$(git rev-parse --git-common-dir)/hooks/$name" "$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/$name"; do
    [ -x "$h" ] && [ "$(realpath "$h")" != "$self" ] || continue
    printf '%s' "${HOOK_STDIN:-}" | "$h" "$@" || return $?
  done
}

scan() {
  if [ "${PIPELINEKIT_ALLOW_SECRET:-}" = 1 ]; then
    echo "pre-commit: PIPELINEKIT_ALLOW_SECRET=1, secret scan skipped" >&2
    return 0
  fi
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: warning: gitleaks not installed, staged secrets NOT scanned (https://github.com/gitleaks/gitleaks)" >&2
    return 0
  fi
  git diff --cached --quiet && return 0
  local ver sub=git rc=0
  ver=$(gitleaks version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
  if [ -n "$ver" ] && [ "${ver%%.*}" -eq 8 ] && [ "${ver#*.}" -lt 19 ]; then
    sub=protect
  fi
  gitleaks "$sub" --staged --redact --no-banner --exit-code 3 -v >&2 || rc=$?
  case $rc in
    0) return 0 ;;
    3) echo "pre-commit: gitleaks found secret(s) in staged changes (values redacted above). Unstage them; PIPELINEKIT_ALLOW_SECRET=1 overrides one commit." >&2 ;;
    *) echo "pre-commit: gitleaks $sub failed (exit $rc); commit refused. Fix gitleaks or set PIPELINEKIT_ALLOW_SECRET=1 for one commit." >&2 ;;
  esac
  return 1
}

scan || exit 1
chain pre-commit "$@" || exit $?
exit 0
