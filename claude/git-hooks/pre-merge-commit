#!/usr/bin/env bash
# Global git pre-merge-commit hook (core.hooksPath = ~/.claude/git-hooks).
# `git merge` runs this hook, not pre-commit, before it records a merge it made
# without conflicts. It scans the merged changes with gitleaks and checks the
# file size limit on the merged index, as pre-commit does for a commit, then
# runs the repo's own pre-merge-commit hook (.git/hooks/pre-merge-commit or
# .githooks/pre-merge-commit) if there is one. `git merge --no-verify` skips
# all of it, as `git commit --no-verify` skips pre-commit.
#   - Secret scan: the same as pre-commit's, of what the merge changes against
#     the current commit, with the same rule ids. gitleaks missing: warn and
#     allow. PIPELINEKIT_ALLOW_SECRET=1 lets one merge through a finding or a
#     failed scan (humans only); it is logged only when it does.
#     A refused merge is left unfinished, like one with a conflict.
#   - File size limit (../hooks/filesize.py): a merge that takes a hand-written
#     file past 1,500 lines or 50,000 bytes is refused and left unfinished;
#     `git commit` concludes it after the file is split, and pre-commit checks
#     it again. A file over the limit in either parent only warns. A check
#     that fails warns and lets the merge through.
#   - The merge has already written the merged files to the working tree, so
#     .githooks/pre-merge-commit runs only when it is the executable file the
#     current commit has: a merge never runs a hook it brings in.
set -u

committed() { # committed <path in repo> <file>: the file is the executable one HEAD has
  local mode type sha rest
  read -r mode type sha rest < <(git ls-tree --full-tree HEAD -- "$1" 2>/dev/null) || return 1
  [ "$mode" = 100755 ] && [ "$type" = blob ] &&
    [ "$sha" = "$(git hash-object --no-filters -- "$2" 2>/dev/null)" ]
}

chain() {
  local name=$1 self h top; shift
  self=$(realpath "$0")
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  for h in "$(git rev-parse --git-common-dir)/hooks/$name" "$top/.githooks/$name"; do
    [ -x "$h" ] && [ "$(realpath "$h")" != "$self" ] || continue
    if [ "$h" = "$top/.githooks/$name" ] && ! committed ".githooks/$name" "$h"; then
      echo "$name: warning: .githooks/$name is not run: it is not the executable file the current commit has." >&2
      continue
    fi
    "$h" "$@" || return $?
  done
}

kitlog() { # kitlog <kind> <rule> <reason>: one line in the kit's event log; never fails
  python3 "$(dirname "$(realpath "$0")")/../hooks/kitlog.py" pre-merge-commit "$@" </dev/null >/dev/null 2>&1 || true
}

scan() {
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-merge-commit: warning: gitleaks not installed, merged changes NOT scanned for secrets (https://github.com/gitleaks/gitleaks)" >&2
    return 0
  fi
  git diff --cached --quiet && return 0
  local ver sub=git rc=0
  ver=$(gitleaks version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
  if [ -n "$ver" ] && [ "${ver%%.*}" -eq 8 ] && [ "${ver#*.}" -lt 19 ]; then
    sub=protect
  fi
  gitleaks "$sub" --staged --redact --no-banner --exit-code 3 -v >&2 || rc=$?
  [ "$rc" = 0 ] && return 0
  if [ "${PIPELINEKIT_ALLOW_SECRET:-}" = 1 ]; then
    # The override is used, and logged, only when the scan would refuse.
    if [ "$rc" = 3 ]; then
      echo "pre-merge-commit: PIPELINEKIT_ALLOW_SECRET=1 lets this merge through with the secret(s) gitleaks found above." >&2
      kitlog override pre-commit.allow-secret "PIPELINEKIT_ALLOW_SECRET=1 let a merge through a secret finding"
    else
      echo "pre-merge-commit: gitleaks $sub failed (exit $rc); PIPELINEKIT_ALLOW_SECRET=1 lets this merge through unscanned." >&2
      kitlog override pre-commit.allow-secret "PIPELINEKIT_ALLOW_SECRET=1 let a merge through a failed secret scan (exit $rc)"
    fi
    return 0
  fi
  case $rc in
    3) echo "pre-merge-commit: gitleaks found secret(s) in the changes this merge brings in (values redacted above); the merge is not recorded. PIPELINEKIT_ALLOW_SECRET=1 overrides one merge. [pre-commit.secret]" >&2
       echo "Next: git merge --abort, take the secret out of the branch you merge, then merge again." >&2
       kitlog block pre-commit.secret "gitleaks found secrets in the merged changes" ;;
    *) echo "pre-merge-commit: gitleaks $sub failed (exit $rc); merge not recorded. PIPELINEKIT_ALLOW_SECRET=1 lets one merge through unscanned. [pre-commit.gitleaks-failed]" >&2
       echo "Next: git merge --abort, fix gitleaks, then merge again." >&2
       kitlog error pre-commit.gitleaks-failed "gitleaks $sub failed (exit $rc)" ;;
  esac
  return 1
}

size_check() {
  local rc=0
  python3 "$(dirname "$(realpath "$0")")/../hooks/filesize.py" pre-merge-commit || rc=$?
  case $rc in
    0) return 0 ;;
    3) return 1 ;;
  esac
  echo "pre-merge-commit: warning: file size check failed (exit $rc), file sizes NOT checked; run /kit to see what is broken [pre-commit.file-size-failed]" >&2
  kitlog error pre-commit.file-size-failed "file size check failed (exit $rc)"
  return 0
}

scan || exit 1
size_check || exit 1
chain pre-merge-commit "$@" || exit $?
exit 0